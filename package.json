{
    "name": "react-leaflet-vectorgrid",
    "version": "3.0.0",
    "description": "React wrapper of Leaflet.VectorGrid. Display gridded vector data (sliced GeoJSON, TopoJSON or protobuf vector tiles).",
    "main": "dist/react-leaflet-vectorgrid.min.js",
    "module": "lib/index.js",
    "scripts": {
        "build": "npm run build:lib && npm run build:dist",
        "build:dist": "webpack",
        "build:dev": "webpack --mode development --output-path ./dist --output-filename react-leaflet-vectorgrid.js",
        "build:lib": "npm run compile:lib",
        "clean:lib": "rm -Rf ./lib",
        "compile:lib": "babel src --out-dir lib",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "test:unit": "jest",
        "test:e2e": "playwright test",
        "test:e2e:build": "webpack --config webpack.e2e.config.js",
        "test:all": "npm run test:unit && npm run test:e2e"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mhasbie/react-leaflet-vectorgrid.git"
    },
    "homepage": "https://mhasbie.github.io/react-leaflet-vectorgrid/",
    "keywords": [
        "react",
        "leaflet",
        "react-leaflet",
        "leaflet.vectorgrid",
        "vector-tile",
        "geojson-vt",
        "pbf",
        "topojson",
        "react-leaflet-vectorgrid",
        "react-leaflet-v4",
        "react-leaflet-v5"
    ],
    "author": "M. Hasbie",
    "license": "MIT",
    "peerDependencies": {
        "leaflet": "^1.7.1",
        "react": "^17.0.1 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.1 || ^18.0.0 || ^19.0.0",
        "react-leaflet": "^3.0.0 || ^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.3",
        "@babel/core": "^7.28.5",
        "@babel/plugin-transform-class-properties": "^7.27.1",
        "@babel/plugin-transform-modules-commonjs": "^7.27.1",
        "@babel/preset-env": "^7.28.5",
        "@babel/preset-react": "^7.28.5",
        "@playwright/test": "^1.65.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.0",
        "babel-jest": "^29.7.0",
        "babel-loader": "^10.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "leaflet": "^1.9.4",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-leaflet": "^5.0.0",
        "webpack": "^5.102.1",
        "webpack-cli": "^7.3.1"
    },
    "dependencies": {
        "leaflet.vectorgrid": "^1.3.0"
    },
    "jest": {
        "collectCoverage": true,
        "testEnvironment": "jsdom",
        "transform": {
            "^.+\\.[jt]sx?$": "babel-jest"
        },
        "testMatch": [
            "**/__tests__/**/?(*.)+(spec|test).[jt]s?(x)"
        ],
        "transformIgnorePatterns": [
            "/node_modules/(?!react-leaflet|@react-leaflet|leaflet|leaflet.vectorgrid)/"
        ]
    }
}
